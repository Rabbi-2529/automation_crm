# Production settings for docker-compose.prod.yml. Copy to .env.prod (never commit it) and fill in every CHANGE-ME.
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Your domain (DNS A record → this server). Caddy gets the HTTPS certificate automatically.
DOMAIN=crm.thingbd.com
ALLOWED_HOSTS=crm.thingbd.com
SITE_URL=https://crm.thingbd.com

# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE-ME
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"   (keep it safe: losing it loses saved SMTP/SMS/API secrets)
FIELD_ENCRYPTION_KEY=CHANGE-ME
# Admin site path (not /admin/)
ADMIN_URL=CHANGE-ME-admin/

# Database (the db service is created with these)
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=CHANGE-ME

# Outgoing mail (password resets, task reminders, report emails). Workspaces can add their own SMTP in the app.
# Examples: smtp+tls://user:password@smtp.gmail.com:587   |   smtp+ssl://user:password@mail.thingbd.com:465
EMAIL_URL=smtp+tls://CHANGE-ME
DEFAULT_FROM_EMAIL=ThingBD CRM <no-reply@thingbd.com>
# Server errors are emailed here (comma-separated)
ADMINS=CHANGE-ME@thingbd.com

# Backups: nightly at BACKUP_HOUR (server time zone below), kept this many days
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
TZ=Asia/Dhaka

# Sizing for a small VPS (2 vCPU / 4 GB)
WEB_WORKERS=3
WORKER_CONCURRENCY=2

# AI assistant: builtin (help center only), ollama, groq, openrouter or openai_compatible
AI_PROVIDER=builtin
# AI_BASE_URL=
# AI_MODEL=
# AI_API_KEY=

# Optional
# API_RATE_LIMIT=120/min
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# SECURE_HSTS_SECONDS=31536000
