# Copy to .env and adjust. Docker Compose reads the same file.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset locally to use SQLite; Docker Compose points this at Postgres.
# DATABASE_URL=postgres://crm:crm@db:5432/crm

# Without Redis running locally, keep tasks eager (they run inline).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=ThingBD CRM <no-reply@thingbd.com>
