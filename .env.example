# Copy to .env and adjust. Docker Compose reads the same file.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset locally to use SQLite; Docker Compose points this at Postgres.
# DATABASE_URL=postgres://crm:crm@db:5432/crm

# Without Redis running locally, keep tasks eager (they run inline).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=ThingBD CRM <no-reply@thingbd.com>

# Used for links in emails sent by background jobs
SITE_URL=http://localhost:8000

# Encrypts saved SMTP/IMAP/SMS secrets. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# REST API rate limit per key (DRF format, e.g. 120/min, 5000/hour)
# API_RATE_LIMIT=120/min
# AI assistant default (workspaces can override in Workspace → AI assistant). Free options:
#   ollama  - open-source models on your own machine: install Ollama, `ollama pull llama3.2:3b`
#   groq / openrouter - hosted open-source models with a free API key
#   builtin - no AI, the help center answers
AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2:3b
# AI_API_KEY=
# Outgoing webhooks to localhost/private IPs are blocked unless this is True (dev settings turn it on)
# ALLOW_PRIVATE_WEBHOOKS=False
